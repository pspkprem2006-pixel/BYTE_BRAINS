# ByteBrains backend environment variables.
# Copy this file to ".env" and adjust values locally.
# Never commit the real ".env" file. DO NOT hardcode credentials.

# --- Application ---
# APP_NAME=ByteBrains API
# APP_VERSION=0.1.0

# --- Database (PostgreSQL) ---
# SQLAlchemy connection URL using the psycopg (psycopg 3) driver.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Note: special characters in the password must be percent-encoded
# (e.g. "@" becomes %40).
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/bytebrains

# --- AI Tutor (OpenRouter) ---
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=
# Model to use for the AI Tutor. See https://openrouter.ai/models for options.
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Production: your Vercel app URL, e.g. https://bytebrains.vercel.app
CORS_ORIGINS=http://localhost:5173