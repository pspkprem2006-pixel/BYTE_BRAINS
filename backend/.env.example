# ByteBrains backend environment variables.
# Copy this file to ".env" and adjust values locally.
# Never commit the real ".env" file. DO NOT hardcode credentials.

# --- Application ---
# APP_NAME=ByteBrains API
# APP_VERSION=0.1.0

# --- Database (Phase 4+: PostgreSQL) ---
# Left empty until the database phase configures the actual connection.
DATABASE_URL=

# Expected variables for the database phase (example only, not used yet):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=bytebrains
# DB_PASSWORD=
# DB_NAME=bytebrains