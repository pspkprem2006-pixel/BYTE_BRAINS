# ByteBrains backend environment variables.
# Copy this file to ".env" and adjust values locally.
# Never commit the real ".env" file. DO NOT hardcode credentials.

# --- Application ---
# APP_NAME=ByteBrains API
# APP_VERSION=0.1.0

# --- Database (PostgreSQL) ---
# SQLAlchemy connection URL using the psycopg (psycopg 3) driver.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Note: special characters in the password must be percent-encoded
# (e.g. "@" becomes %40).
# The app also accepts postgres://, postgresql://, and
# postgresql+psycopg2:// URLs (e.g. the one Render generates) and
# automatically rewrites them to the psycopg 3 dialect.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/bytebrains

# --- AI Tutor (OpenRouter) ---
# Get your API key from https://openrouter.ai
OPENROUTER_API_KEY=
# Model to use for the AI Tutor. See https://openrouter.ai/models for options.
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Web Search (Brave) ---
# Server-side API key for Brave Search (https://brave.com/search/api/).
# Optional: the app starts without it and web search then returns a
# controlled "not configured" response. NEVER expose this key to frontend
# code or put it in VITE_* variables; set it in backend/.env (or the Render
# dashboard) only.
BRAVE_SEARCH_API_KEY=
# Master switch; leave true when a key is set.
WEB_SEARCH_ENABLED=true
# Timeout for provider calls, in seconds (clamped to 1-30).
WEB_SEARCH_TIMEOUT_SECONDS=10
# Maximum results per search (clamped to 1-10).
WEB_SEARCH_MAX_RESULTS=5
# Comma-separated list of domains whose results may be marked "official"
# in learning-resource discovery. Keep it small and maintainable; subdomains
# (e.g. docs.postgresql.org) count automatically, lookalikes do not.
WEB_SEARCH_TRUSTED_DOMAINS=postgresql.org,python.org,nodejs.org
# Maximum number of query variants per learning-resource discovery
# (e.g. "<topic>", "<topic> tutorial", "<topic> official documentation").
# Keeps search usage controlled (clamped to 1-5).
WEB_SEARCH_LEARNING_MAX_QUERIES=4

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Production: your Vercel app URL, e.g. https://bytebrains.vercel.app
CORS_ORIGINS=http://localhost:5173